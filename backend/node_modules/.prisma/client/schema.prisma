generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. NÚCLEO MULTI-TENANT Y SEGURIDAD
// ==========================================
model Tenant {
  id          String   @id @default(uuid())
  name        String
  subdomain   String   @unique
  emailDomain String   @unique // Ej: @cocacola.com
  themeColor  String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  users User[]
}

model Role {
  id          String @id @default(uuid())
  name        String // Ej: SUPER_ADMIN, HR_ADMIN, BASIC_USER
  permissions Json // Define accesos estrictos: { "hr": "write", "tickets": "all" }
  users       User[]
}

model User {
  id             String @id @default(uuid())
  numeroEmpleado String @unique // ID de 6 dígitos para el login general
  email          String @unique // OBLIGATORIO: Correo corporativo
  password       String // Contraseña encriptada obligatoria

  // Datos básicos para el token y la interfaz visual
  firstName String
  lastName  String
  avatarUrl String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  isActive  Boolean  @default(true) // Borrado Lógico (Soft Delete)
  createdAt DateTime @default(now())

  // Relaciones a Módulos
  hrProfile HR_Profile?
  itAssets  IT_Asset[]
  payrolls  Finance_Payroll[]

  // Relaciones al Helpdesk y Sistema
  createdTickets  Ticket[]       @relation("TicketCreator")
  assignedTickets Ticket[]       @relation("TicketAssignee")
  notifications   Notification[]
  auditLogs       Audit_Log[]

  @@index([tenantId])
}

// ==========================================
// 2. MÓDULOS ERP (Silos de Información)
// ==========================================

model HR_Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  position     String
  hireDate     DateTime
  baseSalary   Decimal  @db.Decimal(10, 2)
  contractType String
  documentUrl  String?

  tenantId String

  @@index([tenantId])
}

model IT_Asset {
  id           String @id @default(uuid())
  serialNumber String
  deviceType   String
  model        String
  status       String

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  tenantId String

  @@index([tenantId])
}

model Finance_Payroll {
  id          String   @id @default(uuid())
  paymentDate DateTime
  amountNet   Decimal  @db.Decimal(10, 2)
  status      String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String

  @@index([tenantId])
}

// ==========================================
// 3. HELPDESK Y COMUNICACIÓN TRANSVERSAL
// ==========================================
enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Area {
  HR
  IT
  FINANCE
  GENERAL
}

model Ticket {
  id            String       @id @default(uuid())
  title         String
  description   String       @db.Text
  status        TicketStatus @default(PENDING)
  targetArea    Area
  attachmentUrl String?

  creatorId String
  creator   User   @relation("TicketCreator", fields: [creatorId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id])

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  tenantId String

  @@index([tenantId])
}

model Notification {
  id      String  @id @default(uuid())
  message String
  isRead  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  tenantId  String

  @@index([tenantId])
}

// ==========================================
// 4. CAJA NEGRA (Auditoría)
// ==========================================
model Audit_Log {
  id        String @id @default(uuid())
  action    String
  tableName String
  recordId  String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  tenantId  String

  @@index([tenantId])
}
